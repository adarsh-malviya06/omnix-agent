# OMNIX Agent Environment Configuration Template
# Copy this file to .env and configure for your local environment

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="OMNIX Agent"
APP_VERSION="1.0.0"
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# LLM / Groq Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# Database Configuration (Reserved for Phase 5)
DATABASE_URL=sqlite:///./omnix.db

# Vector Database / RAG (Reserved for Phase 8)
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Business Rules & Spending Limits
DEFAULT_CURRENCY=INR
MAX_AUTO_APPROVAL_LIMIT=75000.00
HIGH_VALUE_THRESHOLD=400000.00
